{
  "name": "site-sobre-mim",
  "version": "2.0.0",
  "description": "Portfólio estático de João Victor Barros das Merces",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "python3 -m http.server ${PORT:-8080}",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:js": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run format:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.22.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "vitest": "^5.1.2"
  }
}
